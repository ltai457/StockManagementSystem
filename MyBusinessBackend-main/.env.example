# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=radiatorstockdb
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT
JWT__Secret=ReplaceWith32CharOrMoreSecret
JWT__Issuer=RadiatorStockAPI
JWT__Audience=RadiatorStockAPI-Users
JWT__AccessTokenExpirationMinutes=30
JWT__RefreshTokenExpirationDays=7

# Frontend origins allowed to call the API in production
ALLOWED_ORIGINS=http://localhost:5173

# Production release controls
# Apply migrations in CI/CD with `dotnet ef database update`. Enable this only
# for a deliberate one-instance bootstrap deployment.
RUN_MIGRATIONS_ON_STARTUP=false

# Optional one-time administrator bootstrap for a completely empty database.
# Remove these secrets after the first successful production startup.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Persistent image storage
UPLOADS_ROOT_PATH=wwwroot/uploads
UPLOADS_REQUEST_PATH=/uploads
