# /home/deploy/api/.env on the production droplet.
# Loaded by DotNetEnv at API startup. Real values live ONLY on the droplet
# (chmod 600, owned by the deploy user). Never commit the real file.

# --- Database (PostgreSQL on the same droplet) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=radiatorstockdb
DB_USERNAME=radiator_user
DB_PASSWORD=replace-with-strong-password

# --- JWT (ASP.NET reads the double-underscore keys) ---
JWT__Secret=replace-with-output-of-openssl-rand-base64-48
JWT__Issuer=RadiatorStockAPI
JWT__Audience=RadiatorStockAPI-Users

# --- CORS: must match the public origin the frontend is loaded from ---
ALLOWED_ORIGINS=http://157.245.206.102

# Apply migrations as a separate deployment step. For the first single-instance
# bootstrap only, this can temporarily be set to true.
RUN_MIGRATIONS_ON_STARTUP=false

# Optional one-time bootstrap for a new, empty production database. Remove the
# values from the server after the administrator has been created.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# --- Uploaded image storage ---
# UPLOADS_ROOT_PATH must be an ABSOLUTE path. If left empty/relative the
# StaticFiles middleware will end up rooted at the API working directory,
# which exposes appsettings.json and other backend files at /uploads/*.
UPLOADS_ROOT_PATH=/home/deploy/api/wwwroot/uploads
UPLOADS_REQUEST_PATH=/uploads
