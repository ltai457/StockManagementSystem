[Unit]
Description=Stock Management API
After=network.target

[Service]
WorkingDirectory=/var/www/stock-app/backend
ExecStart=/usr/bin/dotnet /var/www/stock-app/backend/RadiatorStockAPI.dll
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=stock-management-api
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:5128
Environment=DB_HOST=localhost
Environment=DB_PORT=5432
Environment=DB_NAME=radiatorstockdb
Environment=DB_USERNAME=postgres
Environment=DB_PASSWORD=change-me
Environment=JWT__Secret=change-me-to-a-long-random-secret
Environment=JWT__Issuer=RadiatorStockAPI
Environment=JWT__Audience=RadiatorStockAPI-Users
Environment=JWT__AccessTokenExpirationMinutes=30
Environment=JWT__RefreshTokenExpirationDays=7
Environment=ALLOWED_ORIGINS=https://your-domain.com
Environment=UPLOADS_ROOT_PATH=/var/www/stock-app/uploads
Environment=UPLOADS_REQUEST_PATH=/uploads

[Install]
WantedBy=multi-user.target
